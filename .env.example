# Public URL of your Render web service (no trailing slash)
PUBLIC_URL=https://YOUR-SERVICE.onrender.com

# Discord Developer Portal -> OAuth2
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_CLIENT_SECRET

# Required only if you want reviewer-role support and bot-side member role checks.
# The bot must be in the same Discord servers you manage.
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Long random secret used to sign dashboard sessions.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Render PostgreSQL connection string.
DATABASE_URL=YOUR_RENDER_POSTGRES_INTERNAL_DATABASE_URL
